ate>\n  </VueFlow>\n</template>\n```\n\n```vue\n<script lang=\"ts\" setup>\nimport { Handle, Position } from '@vue-flow/core'\nimport { NodeResizer } from '@vue-flow/node-resizer'\n\n// make sure to include the necessary styles!\nimport '@vue-flow/node-resizer/dist/style.css'\n\ndefineProps(['label'])\n</script>\n\n<template>\n  <NodeResizer min-width=\"100\" min-height=\"30\" />\n\n  <Handle type=\"target\" :position=\"Position.Left\" />\n  <div style=\"padding: 10px\">{{ label }}</div>\n  <Handle type=\"source\" :position=\"Position.Right\" />\n</template>\n```\n","repository":{"type":"git","url":"git+https://github.com/bcakmakoglu/vue-flow/packages/plugins/node-resizer"},"keywords":["vue","flow","diagram","editor","graph","node","link","port","slot","vue3","composition-api","vue-flow","vueflow","typescript"],"_source_registry_name":"default"}